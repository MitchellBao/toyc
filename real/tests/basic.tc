const int base = 5;
int global = base + 2;

int add(int a, int b) {
    return a + b;
}

int fact(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

int main() {
    int i = 0;
    int sum = 0;
    while (i < 5) {
        i = i + 1;
        if (i == 3) {
            continue;
        }
        sum = sum + i;
    }
    if (sum == 12 && add(global, fact(3)) == 13) {
        return 42;
    }
    return 1;
}
