int guard = 1;

int main() {
    int sum = 0;
    int a = 0;
    while (a < 8) {
        int b = 0;
        while (b < 9) {
            int c = 0;
            while (c < 10) {
                int d = 0;
                while (d < 11) {
                    sum = sum + a + b + c + guard;
                    d = d + 1;
                }
                c = c + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return sum % 256;
}
