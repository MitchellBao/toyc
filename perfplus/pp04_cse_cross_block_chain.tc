int main() {
    int a = 11;
    int b = 19;
    int sum = 0;
    int i = 0;
    while (i < 420) {
        int x = (a + b) * (a + b);
        if ((i % 2) == 0) {
            sum = sum + x + (a + b) * (a + b);
        } else {
            sum = sum + (b + a) * (b + a) - x;
        }
        i = i + 1;
    }
    return sum % 256;
}
