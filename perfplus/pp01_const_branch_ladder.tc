const int A = 17;
const int B = A * 3 + 5;
const int C = B - A + 9;

int main() {
    int sum = 0;
    int i = 0;
    while (i < 80) {
        int v = (A + B + C) * 2 - (B - A);
        if ((A * 2 + 1) > B) {
            sum = sum + v * 3;
        } else {
            sum = sum + v + C;
        }
        i = i + 1;
    }
    return sum % 256;
}
