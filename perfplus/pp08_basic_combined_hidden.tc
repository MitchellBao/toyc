int g = 0;

int bump(int x) {
    g = x + 1;
    return g - 1;
}

int main() {
    int sum = 0;
    int i = 0;
    while (i < 180) {
        int a = bump(i);
        int b = (a + 10) - 10;
        int c = (b * 1) + (b - b);
        int j = 0;
        int tmp = 0;
        while (j < 30) {
            tmp = tmp + c;
            j = j + 1;
        }
        sum = (sum + tmp / 30) % 65521;
        i = i + 1;
    }
    return sum % 256;
}
